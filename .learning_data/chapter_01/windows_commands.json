        ],
        "bash": "clear",
        "windows_cmd": "cls",
        "powershell": "Clear-Host",
        "context_notes": "'cls' is the standard for Windows CMD. PowerShell accepts 'cls' and 'clear' as aliases for Clear-Host."
    },
    {
