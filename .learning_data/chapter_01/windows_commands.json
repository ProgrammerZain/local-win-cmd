[
    {
        "category": "Directory Navigation",
        "action": "Show current working directory path",
        "keywords": [
            "where am i",
            "current path",
            "directory location",
            "pwd",
            "cd"
        ],
        "bash": "pwd",
        "windows_cmd": "cd",
        "powershell": "Get-Location",
        "context_notes": "Running 'cd' with no arguments in CMD prints the current directory. In PowerShell, 'pwd' is an alias for Get-Location."
    },
    {
        "category": "Directory Navigation",
        "action": "List all files including hidden files in current directory",
        "keywords": [
            "list",
            "show files",
            "hidden files",
            "ls",
            "dir"
        ],
        "bash": "ls -a or ls -la",
        "windows_cmd": "dir /a",
        "powershell": "Get-ChildItem -Force",
        "context_notes": "In PowerShell, 'dir' and 'ls' are aliases for Get-ChildItem, but parameters like -Force must be used instead of bash flags."
    },
    {
        "category": "File Management",
        "action": "Create a new folder or directory",
        "keywords": [
            "make directory",
            "new folder",
            "create dir",
            "mkdir"
        ],
        "bash": "mkdir folder_name",
        "windows_cmd": "mkdir folder_name",
        "powershell": "New-Item -ItemType Directory -Name folder_name",
        "context_notes": "The 'mkdir' command works natively across Bash, CMD, and PowerShell as an alias or built-in function."
    },
    {
        "category": "File Management",
        "action": "Create an empty file",
        "keywords": [
            "new file",
            "empty file",
            "touch",
            "create text"
        ],
        "bash": "touch filename.txt",
        "windows_cmd": "type nul > filename.txt",
        "powershell": "New-Item filename.txt",
        "context_notes": "Windows CMD doesn't have a direct 'touch' equivalent, so redirecting 'nul' is a common workaround. PowerShell's New-Item is the modern standard."
    },
    {
        "category": "File Management",
        "action": "Delete a file",
        "keywords": [
            "remove file",
            "delete",
            "trash",
            "rm",
            "del"
        ],
        "bash": "rm filename",
        "windows_cmd": "del filename",
        "powershell": "Remove-Item filename",
        "context_notes": "PowerShell aliases 'rm' and 'del' to Remove-Item, but 'del' is the native CMD command."
    },
    {
        "category": "File Management",
        "action": "Delete a directory and all its contents forcefully",
        "keywords": [
            "delete folder",
            "remove directory",
            "recursive delete",
            "rm -rf"
        ],
        "bash": "rm -rf folder_name",
        "windows_cmd": "rmdir /s /q folder_name",
        "powershell": "Remove-Item -Recurse -Force folder_name",
        "context_notes": "CMD uses 'rmdir' or 'rd' with /s (subdirectories) and /q (quiet). Be careful with recursive deletion."
    },
    {
        "category": "File Management",
        "action": "Copy a file",
        "keywords": [
            "duplicate",
            "copy",
            "cp"
        ],
        "bash": "cp source.txt dest.txt",
        "windows_cmd": "copy source.txt dest.txt",
        "powershell": "Copy-Item source.txt -Destination dest.txt",
        "context_notes": "For copying entire directories in CMD, 'xcopy' or 'robocopy' are preferred over the basic 'copy' command."
    },
    {
        "category": "File Management",
        "action": "Move or rename a file",
        "keywords": [
            "move file",
            "rename",
            "mv"
        ],
        "bash": "mv old.txt new.txt",
        "windows_cmd": "move old.txt new.txt",
        "powershell": "Move-Item old.txt -Destination new.txt",
        "context_notes": "In CMD, there is also a dedicated 'rename' or 'ren' command specifically for renaming without moving."
    },
    {
        "category": "Data & Search",
        "action": "Display the contents of a text file",
        "keywords": [
            "read file",
            "print text",
            "show content",
            "cat"
        ],
        "bash": "cat filename.txt",
        "windows_cmd": "type filename.txt",
        "powershell": "Get-Content filename.txt",
        "context_notes": "PowerShell aliases 'cat' to Get-Content, so 'cat filename.txt' works out of the box in PS."
    },
    {
        "category": "Data & Search",
        "action": "Search for a specific string inside a file",
        "keywords": [
            "find text",
            "search string",
            "grep",
            "filter"
        ],
        "bash": "grep 'search_term' filename.txt",
        "windows_cmd": "findstr 'search_term' filename.txt",
        "powershell": "Select-String -Pattern 'search_term' -Path filename.txt",
        "context_notes": "'findstr' is the closest native CMD equivalent to grep. In PowerShell, Select-String provides robust RegEx matching."
    },
    {
        "category": "System & Environment",
        "action": "Clear the terminal screen",
        "keywords": [
            "clear screen",
            "clean terminal",
