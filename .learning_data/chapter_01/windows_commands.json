    {
        "category": "System & Environment",
        "action": "Kill a running process by name",
        "keywords": [
            "stop process",
            "end task",
            "kill",
            "force quit"
        ],
        "bash": "killall process_name",
        "windows_cmd": "taskkill /IM process_name.exe /F",
        "powershell": "Stop-Process -Name process_name -Force",
        "context_notes": "CMD requires the /F flag to forcefully terminate. PowerShell uses the -Force parameter."
    },
